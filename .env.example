# Copy to .env for local development. All settings are optional; defaults in
# src/born_field/config.py are chosen to run with zero credentials.
BORNFIELD_LOG_LEVEL=INFO
BORNFIELD_LOG_JSON=false
BORNFIELD_DATABASE_URL=postgresql+psycopg://bornfield:bornfield@localhost:5432/bornfield
BORNFIELD_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Nested settings use a double underscore:
# BORNFIELD_GRID__CELL_SIZE_M=500
# BORNFIELD_GENERATOR__TRUE_ALPHA=1.35
