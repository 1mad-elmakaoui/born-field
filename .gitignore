# Experiment artefacts
mlruns/
mlartifacts/
mlflow.db
outputs/

# Parquet is ignored by default because ad-hoc analysis scatters it everywhere.
# Two directories are deliberate exceptions and must stay tracked:
#   data/fixtures/ -- the vendored road network. Without it a fresh clone has no
#                     study area, the Docker build fails on `COPY data`, and the
#                     "runs with zero credentials" claim is simply false.
#   experiments/   -- the recorded runs behind every number quoted in the README.
*.parquet
!data/fixtures/*.parquet
!experiments/*.parquet

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
